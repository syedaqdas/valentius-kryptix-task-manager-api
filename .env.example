# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In development, database will be created at this path (or default database.sqlite)
DB_PATH=./data/tasks.db

# JWT Configuration
# Secret key used for signing and verifying tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min32chars
# Token expiration time (e.g., 24h, 7d, 1h)
JWT_EXPIRES_IN=24h
